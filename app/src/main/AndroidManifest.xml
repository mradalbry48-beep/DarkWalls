

    
package com.darkwalls.app

import android.app.Activity
import android.os.Bundle
import android.graphics.Color
import android.graphics.Typeface
import android.graphics.drawable.GradientDrawable
import android.view.Gravity
import android.view.ViewGroup
import android.widget.*

class MainActivity : Activity() {

    private val dark = Color.rgb(12, 15, 18)
    private val green = Color.rgb(0, 220, 130)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        window.statusBarColor = dark
        window.navigationBarColor = dark

        showHome()
    }

    private fun showHome() {
        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setBackgroundColor(dark)
        }

        val scroll = ScrollView(this)
        val content = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(20, 30, 20, 30)
        }

        scroll.addView(content)
        root.addView(
            scroll,
            LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                0,
                1f
            )
        )

        val logo = TextView(this).apply {
            text = "DARKWALLS"
            textSize = 32f
            setTextColor(green)
            typeface = Typeface.DEFAULT_BOLD
            gravity = Gravity.CENTER
        }
        content.addView(logo)

        val subtitle = TextView(this).apply {
            text = "عالم من الخلفيات يليق بهاتفك"
            textSize = 16f
            setTextColor(Color.LTGRAY)
            gravity = Gravity.CENTER
            setPadding(0, 10, 0, 30)
        }
        content.addView(subtitle)

        addHeading(content, "اكتشف الأقسام")

        val categories = listOf(
            "الطبيعة 🌿",
            "الفضاء 🌌",
            "السيارات 🏎️",
            "الفخامة 🖤",
            "الأنمي 🎭"
        )

        categories.forEach { category ->
            addButton(content, category) {
                showMessage("قسم $category قيد التجهيز")
            }
        }

        addHeading(content, "مكتبة الخلفيات")

        addCard(
            content,
            "الخلفيات الثابتة",
            "صور جميلة وعالية الجودة"
        )

        addCard(
            content,
            "الخلفيات المتحركة",
            "اجعل شاشة هاتفك أكثر حيوية"
        )

        addCard(
            content,
            "المفضلة ❤️",
            "خلفياتك المفضلة في مكان واحد"
        )

        val footer = TextView(this).apply {
            text = "DARKWALLS • VERSION 1.0"
            textSize = 12f
            setTextColor(Color.GRAY)
            gravity = Gravity.CENTER
            setPadding(0, 30, 0, 10)
        }
        content.addView(footer)

        setContentView(root)
    }

    private fun addHeading(
        parent: LinearLayout,
        text: String
    ) {
        val heading = TextView(this).apply {
            this.text = text
            textSize = 21f
            setTextColor(Color.WHITE)
            typeface = Typeface.DEFAULT_BOLD
            setPadding(0, 25, 0, 15)
        }
        parent.addView(heading)
    }

    private fun addButton(
        parent: LinearLayout,
        text: String,
        action: () -> Unit
    ) {
        val button = Button(this).apply {
            this.text = text
            textSize = 16f
            setTextColor(Color.WHITE)
            setBackgroundColor(Color.rgb(30, 38, 40))
            setOnClickListener { action() }
        }

        val params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            58
        )
        params.bottomMargin = 10
        parent.addView(button, params)
    }

    private fun addCard(
        parent: LinearLayout,
        title: String,
        description: String
    ) {
        val card = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(20, 18, 20, 18)

            val shape = GradientDrawable().apply {
                setColor(Color.rgb(25, 33, 34))
                cornerRadius = 22f
                setStroke(2, green)
            }
            background = shape
        }

        val heading = TextView(this).apply {
            text = title
            textSize = 20f
            setTextColor(green)
            typeface = Typeface.DEFAULT_BOLD
        }

        val detail = TextView(this).apply {
            text = description
            textSize = 14f
            setTextColor(Color.LTGRAY)
            setPadding(0, 8, 0, 15)
        }

        val button = Button(this).apply {
            text = "استكشف"
            setTextColor(Color.BLACK)
            setBackgroundColor(green)
            setOnClickListener {
                showMessage("$title قيد التجهيز")
            }
        }

        card.addView(heading)
        card.addView(detail)
        card.addView(button)

        val params = LinearLayout.LayoutParams(
            ViewGroup.LayoutParams.MATCH_PARENT,
            ViewGroup.LayoutParams.WRAP_CONTENT
        )
        params.bottomMargin = 18
        parent.addView(card, params)
    }

    private fun showMessage(message: String) {
        Toast.makeText(
            this,
            message,
            Toast.LENGTH_SHORT
        ).show()
    }
}
